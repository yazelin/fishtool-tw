---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { loadCategoryMap, url } from '../../lib/data';

export async function getStaticPaths() {
  const menus = await getCollection('menus');
  return menus.map((m) => ({
    params: { menu_id: String(m.data.menu_id) },
    props: { menu: m.data },
  }));
}

const { menu } = Astro.props;
const categories = await loadCategoryMap();

const subs = menu.subcategories
  .map((s) => categories.get(s.sid) ?? { sid: s.sid, name: s.name, total_count: 0, all_product_ids: [], breadcrumb: [] })
  .sort((a, b) => (b.total_count ?? 0) - (a.total_count ?? 0));
---

<Base title={menu.name}>
  <div class="container">
    <Breadcrumb items={[{ label: menu.name }]} />
    <header class="page-head">
      <h1>{menu.name}</h1>
      <p>{menu.subcategories.length} 個子分類</p>
    </header>

    <ul class="subcat-grid">
      {subs.map((s) => (
        <li>
          <a href={url(`categories/${s.sid}`)} class="subcat-tile">
            <h3>{s.name}</h3>
            <span class="count">{s.total_count ?? 0} 件商品</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .page-head {
    margin-block: var(--space-5) var(--space-6);
  }
  .page-head h1 { font-size: var(--text-3xl); }
  .page-head p { color: var(--fg-secondary); margin-top: var(--space-2); }

  .subcat-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  @media (min-width: 600px) { .subcat-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .subcat-grid { grid-template-columns: repeat(4, 1fr); } }

  .subcat-tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-3);
    background: var(--bg-soft);
    border: 1px solid var(--border-soft);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    min-height: 96px;
    color: var(--fg-primary);
    transition: border-color var(--duration-base) var(--ease-out),
                transform var(--duration-base) var(--ease-out);
  }
  .subcat-tile:hover { border-color: var(--brand-tide); color: var(--fg-primary); transform: translateY(-2px); }
  .subcat-tile h3 { font-size: var(--text-base); font-weight: 600; }
  .count { font-size: var(--text-xs); color: var(--fg-secondary); }
</style>
