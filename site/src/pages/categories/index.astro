---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { loadMenuList, url } from '../../lib/data';

const cats = (await getCollection('categories')).map((c) => c.data)
  .sort((a, b) => (b.total_count ?? 0) - (a.total_count ?? 0));
const catBySid = new Map(cats.map((c) => [c.sid, c]));
const menus = await loadMenuList();

const groups = menus
  .map((m) => ({
    menu: m,
    subs: m.subcategories
      .map((s) => catBySid.get(s.sid))
      .filter((c): c is NonNullable<typeof c> => !!c),
  }))
  .filter((g) => g.subs.length > 0);
---

<Base title="全部商品分類">
  <div class="container">
    <header class="page-head">
      <h1>全部分類</h1>
      <p><strong>{cats.length}</strong> 個子分類 · 共 <strong>{cats.reduce((s, c) => s + (c.total_count ?? 0), 0).toLocaleString('zh-Hant')}</strong> 件商品</p>
    </header>

    <section class="by-menu">
      {groups.map(({ menu, subs }) => (
        <div class="menu-block">
          <header class="menu-head">
            <h2><a href={url(`menus/${menu.menu_id}`)}>{menu.name}</a></h2>
            <span class="menu-sub-count">{subs.length} 個子分類</span>
          </header>
          <ul>
            {subs.map((c) => (
              <li>
                <a href={url(`categories/${c.sid}`)}>
                  <span class="name">{c.name}</span>
                  <span class="count">{c.total_count}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </div>
</Base>

<style>
  .page-head { margin-block: var(--space-5) var(--space-7); }
  .page-head h1 { font-size: var(--text-3xl); }
  .page-head p { color: var(--fg-secondary); margin-top: var(--space-2); font-size: var(--text-sm); }
  .page-head strong { color: var(--fg-primary); font-weight: 600; }

  .by-menu { display: grid; gap: var(--space-8); padding-bottom: var(--space-7); }
  .menu-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
    gap: var(--space-3);
  }
  .menu-block h2 { font-size: var(--text-xl); }
  .menu-block h2 a { color: var(--fg-primary); }
  .menu-block h2 a:hover { color: var(--brass-500); }
  .menu-sub-count { font-size: var(--text-xs); color: var(--fg-muted); }

  .menu-block ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-2);
  }
  .menu-block li a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    border: 1px solid var(--border-soft);
    color: var(--fg-primary);
    transition: background var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }
  .menu-block li a:hover { background: var(--bg-elevated-hover); }
  .menu-block .name { font-size: var(--text-sm); }
  .count { color: var(--fg-muted); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
</style>
