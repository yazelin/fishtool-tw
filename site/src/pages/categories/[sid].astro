---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductCard from '../../components/ProductCard.astro';
import { loadProductMap, extractBrand, pickThumb } from '../../lib/data';

export async function getStaticPaths() {
  const cats = await getCollection('categories');
  return cats.map((c) => ({
    params: { sid: String(c.data.sid) },
    props: { category: c.data },
  }));
}

const { category } = Astro.props;
const products = await loadProductMap();

const items = category.all_product_ids
  .map((pid) => products.get(pid))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);

const crumbs = category.breadcrumb.map((label) => ({ label }));
---

<Base title={category.name}>
  <div class="container">
    <Breadcrumb items={crumbs.length > 0 ? crumbs : [{ label: category.name }]} />

    <header class="page-head">
      <h1>{category.name}</h1>
      <p>共 {category.total_count.toLocaleString('zh-Hant')} 件商品</p>
    </header>

    <div class="toolbar">
      <div class="sort">
        <label>排序</label>
        <select disabled aria-label="排序方式">
          <option>上架日期：新到舊</option>
          <option>價格：低到高</option>
          <option>價格：高到低</option>
        </select>
      </div>
      <div class="meta">顯示 {items.length} / {category.total_count}</div>
    </div>

    {items.length > 0 ? (
      <div class="grid-cards">
        {items.map((p) => (
          <ProductCard
            pid={p.pid}
            sku={p.sku}
            name={p.name}
            price={p.price}
            salePrice={p.sale_price}
            thumb={pickThumb(p)}
            brand={extractBrand(p.name)}
          />
        ))}
      </div>
    ) : (
      <p class="empty">這個分類目前還沒有商品資料。</p>
    )}
  </div>
</Base>

<style>
  .page-head { margin-block: var(--space-5) var(--space-5); }
  .page-head h1 { font-size: var(--text-3xl); }
  .page-head p { color: var(--fg-secondary); margin-top: var(--space-2); }

  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-block: 1px solid var(--border-subtle);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }
  .sort { display: flex; align-items: center; gap: var(--space-3); font-size: var(--text-sm); color: var(--fg-secondary); }
  .sort select {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    color: var(--fg-primary);
  }
  .meta { color: var(--fg-secondary); font-size: var(--text-sm); }

  .empty {
    padding: var(--space-8);
    text-align: center;
    color: var(--fg-secondary);
    background: var(--bg-elevated);
    border-radius: var(--radius-md);
  }
</style>
