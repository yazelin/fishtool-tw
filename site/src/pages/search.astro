---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { loadProductMap, extractBrand, pickThumb } from '../lib/data';

// 純 client side 過濾的搜尋頁；之後可換成 build-time 預先索引或 Pagefind
const products = await loadProductMap();
const all = Array.from(products.values());
const dataset = all.map((p) => ({
  pid: p.pid,
  sku: p.sku,
  name: p.name,
  price: p.price,
  sale_price: p.sale_price,
  thumb: pickThumb(p),
  brand: extractBrand(p.name),
  q: [p.name, p.sku, extractBrand(p.name)].filter(Boolean).join(' ').toLowerCase(),
}));
---

<Base title="搜尋商品">
  <div class="container">
    <header class="head">
      <h1>搜尋商品</h1>
      <form class="search-form" method="get">
        <input type="search" name="q" id="q" placeholder="輸入關鍵字、編號、品牌…" autocomplete="off" />
      </form>
      <p id="status" class="status">輸入關鍵字後即時顯示符合的商品。</p>
    </header>

    <div id="results" class="grid-cards"></div>
  </div>

  <script type="application/json" id="dataset" set:html={JSON.stringify(dataset)} />
  <template id="card-template">
    <a class="card" href="">
      <div class="thumb"><img loading="lazy" /></div>
      <div class="body">
        <div class="meta"><span class="brand"></span><span class="sku"></span></div>
        <h3 class="name"></h3>
        <div class="price"></div>
      </div>
    </a>
  </template>

  <script is:inline>
    const data = JSON.parse(document.getElementById('dataset').textContent);
    const params = new URLSearchParams(location.search);
    const input = document.getElementById('q');
    const results = document.getElementById('results');
    const status = document.getElementById('status');
    const initial = params.get('q') ?? '';
    input.value = initial;

    const fmt = (n) => (n == null ? '—' : '$' + n.toLocaleString('zh-Hant'));

    function render(q) {
      const term = q.trim().toLowerCase();
      results.innerHTML = '';
      if (!term) {
        status.textContent = '輸入關鍵字後即時顯示符合的商品。';
        return;
      }
      const matched = data.filter((d) => d.q.includes(term)).slice(0, 200);
      status.textContent = `符合 ${matched.length.toLocaleString('zh-Hant')} 件（最多顯示 200）`;
      const tpl = document.getElementById('card-template').content;
      const frag = document.createDocumentFragment();
      for (const p of matched) {
        const node = tpl.cloneNode(true);
        const link = node.querySelector('a');
        link.href = `products/${p.pid}`;
        link.className = 'card';
        const img = node.querySelector('img');
        if (p.thumb) img.src = p.thumb;
        node.querySelector('.brand').textContent = p.brand ?? '';
        node.querySelector('.sku').textContent = p.sku ?? '';
        node.querySelector('.name').textContent = p.name ?? '';
        const hasSale = p.price != null && p.sale_price != null && p.sale_price < p.price;
        node.querySelector('.price').innerHTML = hasSale
          ? `<span class="sale">${fmt(p.sale_price)}</span><span class="orig">${fmt(p.price)}</span>`
          : `<span class="sale">${fmt(p.sale_price ?? p.price)}</span>`;
        frag.appendChild(node);
      }
      results.appendChild(frag);
    }

    let timer;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => render(input.value), 120);
      const params = new URLSearchParams(location.search);
      params.set('q', input.value);
      history.replaceState(null, '', '?' + params.toString());
    });

    render(initial);
  </script>
</Base>

<style>
  .head { margin-block: var(--space-5) var(--space-6); }
  .search-form input {
    width: 100%;
    height: 48px;
    padding-inline: var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--fg-primary);
    font-size: var(--text-lg);
  }
  .status { margin-top: var(--space-3); color: var(--fg-secondary); font-size: var(--text-sm); }

  /* 搜尋結果卡片樣式（簡化版） */
  :global(#results .card) {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }
  :global(#results .thumb) {
    aspect-ratio: 1;
    background: var(--ink-800);
    display: grid;
    place-items: center;
  }
  :global(#results .thumb img) { width: 100%; height: 100%; object-fit: contain; }
  :global(#results .body) { padding: var(--space-3); display: grid; gap: var(--space-2); }
  :global(#results .meta) { display: flex; justify-content: space-between; font-size: var(--text-xs); color: var(--fg-secondary); }
  :global(#results .name) { font-size: var(--text-base); line-height: 1.3; min-height: 2.6em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  :global(#results .price) { display: flex; gap: var(--space-2); align-items: baseline; }
  :global(#results .price .sale) { font-size: var(--text-lg); font-weight: 700; color: var(--accent-ember); }
  :global(#results .price .orig) { font-size: var(--text-sm); color: var(--fg-muted); text-decoration: line-through; }
</style>
