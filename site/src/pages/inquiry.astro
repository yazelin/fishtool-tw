---
import Base from '../layouts/Base.astro';
---

<Base title="客服詢問">
  <div class="container">
    <header class="head">
      <h1>客服詢問</h1>
      <p>商品問題、訂單疑問、缺料補貨——這裡留言給我們。</p>
    </header>

    <form class="form" onsubmit="return false">
      <label>
        姓名 / 暱稱
        <input type="text" name="name" required />
      </label>
      <label>
        Email
        <input type="email" name="email" required placeholder="正確信箱才能即時回覆" />
      </label>
      <label>
        商品編號（選填）
        <input type="text" name="sku" placeholder="例如 DM-216276" />
      </label>
      <label>
        詢問內容
        <textarea name="message" rows="6" required></textarea>
      </label>
      <div class="actions">
        <button type="submit" class="btn btn-primary" disabled>送出（後端尚未實作）</button>
      </div>
    </form>

    <aside class="contact-aside">
      <h2>其他聯絡方式</h2>
      <ul>
        <li>Email：<a href="mailto:service@fishtool.tw">service@fishtool.tw</a></li>
        <li>線上聊聊：10:00 – 21:00</li>
        <li>
          <a href="https://www.facebook.com/groups/809912915726639/" target="_blank" rel="noopener">
            Facebook 社團
          </a>
        </li>
      </ul>
    </aside>
  </div>
</Base>

<style>
  .head { margin-block: var(--space-5) var(--space-6); }
  .head p { color: var(--fg-secondary); margin-top: var(--space-2); }

  .form {
    display: grid;
    gap: var(--space-4);
    max-width: var(--article-max);
    background: var(--bg-elevated);
    padding: var(--space-6);
    border-radius: var(--radius-md);
  }
  .form label {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--fg-secondary);
  }
  .form input,
  .form textarea {
    width: 100%;
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    color: var(--fg-primary);
    font-size: var(--text-base);
  }
  .form input:focus,
  .form textarea:focus {
    border-color: var(--brand-tide);
  }

  .actions { margin-top: var(--space-2); }
  .actions .btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .contact-aside {
    margin-top: var(--space-6);
    padding: var(--space-5);
    background: var(--bg-elevated);
    border-radius: var(--radius-md);
    max-width: var(--article-max);
  }
  .contact-aside h2 { font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .contact-aside ul { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2); color: var(--fg-secondary); }
</style>
