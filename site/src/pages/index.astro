---
export const prerender = true;

import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import {
  loadProductMap,
  loadMenuList,
  loadCategoryMap,
  extractBrand,
  pickThumb,
  proxyImg,
  url,
} from '../lib/data';

const products = await loadProductMap();
const menus = await loadMenuList();
const categories = await loadCategoryMap();

const all = Array.from(products.values());
const onSale = all
  .filter((p) => p.price !== null && p.sale_price !== null && p.sale_price! < p.price!)
  .slice(0, 10);
const newArrivals = all.slice(-10).reverse();

// 為每個大類挑一張代表商品照當底圖（從第一個有圖的子分類第一件商品）
function pickMenuCover(menuId: number): string | null {
  const m = menus.find((x) => x.menu_id === menuId);
  if (!m) return null;
  for (const sub of m.subcategories) {
    const cat = categories.get(sub.sid);
    if (!cat) continue;
    for (const pid of cat.all_product_ids) {
      const p = products.get(pid);
      const t = pickThumb(p!);
      if (t) return t;
    }
  }
  return null;
}

// Hero 用一組商品照拼貼
const heroCollageThumbs = [
  onSale[0],
  onSale[1],
  newArrivals[0],
  newArrivals[3],
]
  .filter(Boolean)
  .map((p) => pickThumb(p))
  .filter(Boolean) as string[];

const brands = ['DAIWA', 'SHIMANO', 'OWNER', 'gamakatsu', 'HARiMitsu', 'pokee', 'DUEL', 'KIZAKURA'];
---

<Base title="紅海釣具店">
  {/* === HERO === */}
  <section class="hero">
    <img class="hero-bg" src={url('hero/angler-twilight.png')} alt="" aria-hidden="true" fetchpriority="high" />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="hero-eyebrow">FishTool.tw · 精選釣具一站備齊</span>
        <h1 class="hero-title">
          探索無限可能<br />
          <span class="hero-accent">釣出你的精彩</span>
        </h1>
        <p class="hero-sub">
          磯礁、灘岸、深海、釣蝦——{products.size.toLocaleString('zh-Hant')}+ 件 SKU、<br />
          超過 30 個品牌長期穩定供貨。老店熟客的選擇。
        </p>
        <div class="hero-cta">
          <a href={url('categories')} class="btn btn-primary btn-lg">逛全部商品</a>
          <a href={url('menus/27')} class="btn btn-ghost-on-dark btn-lg">釣竿專區 →</a>
        </div>
      </div>
    </div>
  </section>

  {/* === 11 大類入口 === */}
  <section class="section section-categories">
    <div class="container">
      <header class="section-head">
        <div>
          <h2>11 大類入口</h2>
          <p>從你的釣法或裝備類型開始</p>
        </div>
      </header>
      <ul class="menu-grid">
        {menus.map((m) => {
          const cover = pickMenuCover(m.menu_id);
          return (
            <li>
              <a href={url(`menus/${m.menu_id}`)} class="menu-tile">
                <div class="menu-cover">
                  {cover ? (
                    <img src={cover} alt="" loading="lazy" />
                  ) : (
                    <div class="menu-cover-fallback" aria-hidden="true"></div>
                  )}
                  <span class="menu-cover-shade" aria-hidden="true"></span>
                </div>
                <div class="menu-label">
                  <span class="menu-name">{m.name}</span>
                  <span class="menu-count">{m.subcategories.length} 子分類</span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  {/* === 特價精選 === */}
  {onSale.length > 0 && (
    <section class="section section-grid">
      <div class="container">
        <header class="section-head">
          <div>
            <h2>特價精選</h2>
            <p>當週實際下殺、不是行銷話術</p>
          </div>
          <a href={`${url('search')}?q=特價`} class="see-all">看全部 →</a>
        </header>
        <div class="grid-cards">
          {onSale.map((p) => (
            <ProductCard
              pid={p.pid}
              sku={p.sku}
              name={p.name}
              price={p.price}
              salePrice={p.sale_price}
              thumb={pickThumb(p)}
              brand={extractBrand(p.name)}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {/* === Promo banners === */}
  <section class="section section-promos">
    <div class="container promos">
      <a class="promo promo-a" href={url('menus/27')}>
        {heroCollageThumbs[0] && <img class="promo-bg" src={heroCollageThumbs[0]} alt="" />}
        <div class="promo-body">
          <span class="promo-eyebrow">釣竿專區</span>
          <h3>新品上市</h3>
          <p>磯、海、淡水、路亞——主流品牌新貨陸續到。</p>
          <span class="promo-cta">立即逛 →</span>
        </div>
      </a>
      <a class="promo promo-b" href={`${url('search')}?q=特價`}>
        {heroCollageThumbs[2] && <img class="promo-bg" src={heroCollageThumbs[2]} alt="" />}
        <div class="promo-body">
          <span class="promo-eyebrow">限時特價</span>
          <h3>年中慶典</h3>
          <p>精選下殺、滿千免運、實體門市可取貨。</p>
          <span class="promo-cta">看特價區 →</span>
        </div>
      </a>
    </div>
  </section>

  {/* === 新品上架 === */}
  {newArrivals.length > 0 && (
    <section class="section section-grid">
      <div class="container">
        <header class="section-head">
          <div>
            <h2>新品上架</h2>
            <p>近期入庫的新貨</p>
          </div>
          <a href={url('categories')} class="see-all">看全部 →</a>
        </header>
        <div class="grid-cards">
          {newArrivals.map((p) => (
            <ProductCard
              pid={p.pid}
              sku={p.sku}
              name={p.name}
              price={p.price}
              salePrice={p.sale_price}
              thumb={pickThumb(p)}
              brand={extractBrand(p.name)}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {/* === 品牌牆 === */}
  <section class="brand-wall">
    <div class="container">
      <header class="section-head brand-head">
        <div>
          <h2>合作品牌</h2>
          <p>長期穩定供貨</p>
        </div>
      </header>
      <ul class="brand-row">
        {brands.map((b) => (
          <li><span>{b}</span></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* === HERO（永遠深色，AI 海邊照當底） === */
  .hero {
    position: relative;
    background: var(--ink-900);
    color: #fff;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
    pointer-events: none;
    z-index: 0;
  }
  /* 左側深色漸層蒙版：保證 hero copy 對比 */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg,
        rgba(11, 27, 43, 0.92) 0%,
        rgba(11, 27, 43, 0.78) 28%,
        rgba(11, 27, 43, 0.45) 55%,
        rgba(11, 27, 43, 0.15) 85%,
        rgba(11, 27, 43, 0) 100%),
      linear-gradient(180deg, rgba(11,27,43,0.2) 0%, transparent 30%, transparent 70%, rgba(11,27,43,0.55) 100%);
    z-index: 1;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
    padding-block: var(--space-8);
    min-height: 480px;
  }
  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: minmax(0, 1fr); padding-block: var(--space-9); min-height: 620px; }
    .hero-copy { max-width: 580px; }
  }

  .hero-eyebrow {
    display: inline-block;
    color: var(--brand-tide-soft);
    font-size: var(--text-xs);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
    opacity: 0.85;
  }
  .hero-title {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    line-height: 1.15;
    color: #fff;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .hero-accent {
    background: linear-gradient(120deg, #fff 0%, var(--brand-tide-soft) 60%, #fff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    margin-block: var(--space-5);
    color: rgba(255, 255, 255, 0.78);
    max-width: 52ch;
    line-height: 1.85;
    font-size: var(--text-base);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* ghost-on-dark：在 hero 暗底上的次按鈕 */
  :global(.btn-ghost-on-dark) {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.35);
  }
  :global(.btn-ghost-on-dark:hover) {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.6);
    color: #fff;
  }

  /* （hero-collage 已移除，hero 改用全幅實景照）*/

  /* === Sections === */
  .section { padding-block: var(--space-8); }
  .section-categories { background: var(--bg-base); }
  .section-grid { background: var(--bg-soft); }
  .section-grid + .section-grid { padding-top: 0; }

  /* === 11 大類 — 商品照當底 === */
  .menu-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  @media (min-width: 480px) { .menu-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 768px) { .menu-grid { grid-template-columns: repeat(4, 1fr); gap: var(--space-4); } }
  @media (min-width: 1024px) { .menu-grid { grid-template-columns: repeat(6, 1fr); } }

  .menu-tile {
    display: block;
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    color: #fff;
    border: 1px solid var(--border-soft);
    transition: transform var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out);
    background: var(--bg-soft);
  }
  .menu-tile:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: #fff;
  }
  .menu-cover {
    position: absolute;
    inset: 0;
    background: var(--bg-soft);
    overflow: hidden;
  }
  .menu-cover img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .menu-tile:hover .menu-cover img { transform: scale(1.05); }
  .menu-cover-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, rgba(11,27,43,0.0) 30%, rgba(11,27,43,0.85) 100%);
  }
  .menu-cover-fallback {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, var(--ink-700), var(--ink-900));
  }
  .menu-label {
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .menu-name {
    font-size: var(--text-base);
    font-weight: 700;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0,0,0,0.4);
  }
  .menu-count {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.7);
  }

  /* === Promos === */
  .section-promos { background: var(--bg-base); }
  .promos {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .promos { grid-template-columns: 1fr 1fr; }
  }
  .promo {
    position: relative;
    display: block;
    color: #fff;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 21/9;
    border: 1px solid var(--border-soft);
    background: var(--ink-900);
  }
  .promo:hover { color: #fff; }
  .promo-bg {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.35;
    filter: blur(2px);
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .promo:hover .promo-bg { transform: scale(1.04); }
  .promo-body {
    position: relative;
    padding: var(--space-6);
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 360px;
  }
  .promo-eyebrow {
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    color: var(--brand-tide-soft);
    text-transform: uppercase;
  }
  .promo h3 {
    font-size: var(--text-2xl);
    color: #fff;
    margin: var(--space-2) 0 var(--space-3);
  }
  .promo p {
    color: rgba(255,255,255,0.78);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .promo-cta {
    margin-top: var(--space-4);
    font-weight: 600;
    color: var(--brand-tide-soft);
    font-size: var(--text-sm);
  }

  /* === Brand wall === */
  .brand-wall {
    padding-block: var(--space-8);
    background: var(--bg-soft);
    border-top: 1px solid var(--border-soft);
  }
  .brand-head { margin-bottom: var(--space-5); }
  .brand-row {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  @media (min-width: 600px) { .brand-row { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 900px) { .brand-row { grid-template-columns: repeat(8, 1fr); } }
  .brand-row li {
    height: 72px;
    display: grid;
    place-items: center;
    background: var(--bg-base);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    color: var(--fg-secondary);
    font-weight: 700;
    letter-spacing: 0.04em;
    font-size: var(--text-sm);
    transition: color var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
  }
  .brand-row li:hover {
    color: var(--ink-900);
    border-color: var(--ink-500);
  }
</style>
