---
export const prerender = true;

import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import {
  loadProductMap,
  loadMenuList,
  loadCategoryMap,
  extractBrand,
  pickThumb,
  url,
} from '../lib/data';

const products = await loadProductMap();
const menus = await loadMenuList();
const categories = await loadCategoryMap();

const all = Array.from(products.values());
const onSale = all
  .filter((p) => p.price !== null && p.sale_price !== null && p.sale_price! < p.price!)
  .slice(0, 5);
const newArrivals = all.slice(-5).reverse();

// 為每個大類挑一張代表商品照當底圖
function pickMenuCover(menuId: number): string | null {
  const m = menus.find((x) => x.menu_id === menuId);
  if (!m) return null;
  for (const sub of m.subcategories) {
    const cat = categories.get(sub.sid);
    if (!cat) continue;
    for (const pid of cat.all_product_ids) {
      const p = products.get(pid);
      const t = pickThumb(p!);
      if (t) return t;
    }
  }
  return null;
}

const menuLabelEn: Record<number, string> = {
  26: 'Lures',
  27: 'Rods',
  28: 'Reels',
  29: 'Hooks',
  30: 'Lines',
  31: 'Floats',
  32: 'Apparel',
  33: 'Accessories',
  34: 'Bait',
  35: 'Gear',
  36: 'Brands',
};

const brands = ['SHIMANO', 'DAIWA', 'OWNER', 'gamakatsu', 'HARiMitsu', 'pokee', 'DUEL', 'KIZAKURA'];

const editorialBannerImg = newArrivals[0] ? pickThumb(newArrivals[0]) : null;
---

<Base title="紅海釣具店">
  {/* === HERO === */}
  <section class="hero">
    <img class="hero-bg" src={url('hero/angler-twilight.png')} alt="" aria-hidden="true" fetchpriority="high" />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1 class="hero-title">探索無限可能</h1>
        <p class="hero-sub">釣出你的精彩</p>
        <div class="hero-cta">
          <a href={url('categories')} class="btn btn-hero">逛全部商品</a>
        </div>
      </div>
    </div>
  </section>

  {/* === 11 大類（editorial 單列）=== */}
  <section class="section section-categories">
    <div class="container">
      <header class="section-head section-head-center">
        <span class="eyebrow">CATEGORIES</span>
        <h2>11 大類</h2>
      </header>
      <ul class="menu-row">
        {menus.slice(0, 6).map((m) => {
          const cover = pickMenuCover(m.menu_id);
          return (
            <li>
              <a href={url(`menus/${m.menu_id}`)} class="menu-tile">
                <div class="menu-cover">
                  {cover ? (
                    <img src={cover} alt="" loading="lazy" />
                  ) : (
                    <div class="menu-cover-fallback" aria-hidden="true"></div>
                  )}
                </div>
                <span class="menu-label-en">{menuLabelEn[m.menu_id] ?? ''}</span>
                <span class="menu-label-cn">{m.name}</span>
              </a>
            </li>
          );
        })}
      </ul>
      <div class="menu-row-extra">
        {menus.slice(6).map((m) => {
          const cover = pickMenuCover(m.menu_id);
          return (
            <a href={url(`menus/${m.menu_id}`)} class="menu-tile small">
              <div class="menu-cover">
                {cover ? <img src={cover} alt="" loading="lazy" /> : <div class="menu-cover-fallback"></div>}
              </div>
              <span class="menu-label-en">{menuLabelEn[m.menu_id] ?? ''}</span>
              <span class="menu-label-cn">{m.name}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* === 精選商品 === */}
  {onSale.length > 0 && (
    <section class="section section-products">
      <div class="container">
        <header class="section-head section-head-center">
          <span class="eyebrow">FEATURED</span>
          <h2>精選商品</h2>
          <p class="subtitle">當週實際下殺，不是行銷話術</p>
        </header>
        <div class="product-row">
          {onSale.map((p) => (
            <ProductCard
              pid={p.pid}
              sku={p.sku}
              name={p.name}
              price={p.price}
              salePrice={p.sale_price}
              thumb={pickThumb(p)}
              brand={extractBrand(p.name)}
            />
          ))}
        </div>
        <div class="section-cta">
          <a href={`${url('search')}?q=特價`} class="btn btn-secondary">看全部特價</a>
        </div>
      </div>
    </section>
  )}

  {/* === Editorial banner === */}
  <section class="section editorial-banner">
    {editorialBannerImg && (
      <img class="editorial-bg" src={editorialBannerImg} alt="" loading="lazy" />
    )}
    <div class="editorial-shade" aria-hidden="true"></div>
    <div class="container editorial-content">
      <span class="eyebrow editorial-eyebrow">2026 NEW ARRIVAL</span>
      <h2 class="editorial-title">精工之作<br/>源於對釣魚的熱愛</h2>
      <p class="editorial-sub">每一具捲線器、每一支竿，都是裝備迷的選擇</p>
      <a href={url('menus/28')} class="btn btn-hero-on-light">逛捲線器專區</a>
    </div>
  </section>

  {/* === 新品上架 === */}
  {newArrivals.length > 0 && (
    <section class="section section-products">
      <div class="container">
        <header class="section-head section-head-center">
          <span class="eyebrow">NEW ARRIVALS</span>
          <h2>新品上架</h2>
        </header>
        <div class="product-row">
          {newArrivals.map((p) => (
            <ProductCard
              pid={p.pid}
              sku={p.sku}
              name={p.name}
              price={p.price}
              salePrice={p.sale_price}
              thumb={pickThumb(p)}
              brand={extractBrand(p.name)}
            />
          ))}
        </div>
        <div class="section-cta">
          <a href={url('categories')} class="btn btn-secondary">看全部分類</a>
        </div>
      </div>
    </section>
  )}

  {/* === 品牌牆 === */}
  <section class="brand-wall">
    <div class="container">
      <header class="section-head section-head-center">
        <span class="eyebrow">BRANDS</span>
        <h2 class="serif-italic">Trusted Partners</h2>
      </header>
      <ul class="brand-row">
        {brands.map((b) => (
          <li><span>{b}</span></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* === HERO === */
  .hero {
    position: relative;
    background: var(--ink-900);
    color: var(--cream-050);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center 40%;
    z-index: 0;
  }
  .hero-overlay {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(90deg,
        rgba(26,24,22,0.78) 0%,
        rgba(26,24,22,0.55) 30%,
        rgba(26,24,22,0.25) 60%,
        rgba(26,24,22,0.05) 100%),
      linear-gradient(180deg, rgba(26,24,22,0.15) 0%, transparent 30%, transparent 65%, rgba(26,24,22,0.55) 100%);
  }
  .hero-inner {
    position: relative; z-index: 2;
    display: flex; align-items: center;
    padding-block: var(--space-9);
    min-height: 560px;
  }
  @media (min-width: 900px) {
    .hero-inner { min-height: 680px; }
  }
  .hero-copy { max-width: 580px; }
  .hero-title {
    font-family: var(--font-serif-cn);
    font-size: clamp(2.5rem, 6.5vw, 4.5rem);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--cream-050);
  }
  .hero-sub {
    margin-top: var(--space-4);
    font-family: var(--font-serif-cn);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    color: rgba(245, 241, 232, 0.78);
    letter-spacing: 0.12em;
  }
  .hero-cta { margin-top: var(--space-6); display: flex; gap: var(--space-3); flex-wrap: wrap; }

  /* Hero 上的特殊 CTA：細邊金線 + 大字距 */
  :global(.btn-hero) {
    background: transparent;
    color: var(--cream-050);
    border: 1px solid var(--brass-300);
    height: var(--control-lg);
    padding-inline: var(--space-7);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    border-radius: 0;
    display: inline-flex;
    align-items: center;
    transition: all var(--duration-base) var(--ease-out);
  }
  :global(.btn-hero:hover) {
    background: var(--brass-500);
    border-color: var(--brass-500);
    color: var(--ink-900);
  }
  :global(.btn-hero-on-light) {
    background: var(--cream-050);
    color: var(--ink-text);
    border: 1px solid var(--cream-050);
    height: var(--control-lg);
    padding-inline: var(--space-7);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    border-radius: 0;
    display: inline-flex;
    align-items: center;
    transition: all var(--duration-base) var(--ease-out);
  }
  :global(.btn-hero-on-light:hover) {
    background: var(--brass-500);
    border-color: var(--brass-500);
    color: var(--ink-900);
  }

  /* === Section heads === */
  .section { padding-block: var(--space-9); }
  .section-head-center {
    text-align: center;
    margin-bottom: var(--space-7);
    display: block;
  }
  .section-head-center .eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--brass-700);
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--space-3);
  }
  [data-theme='dark'] .section-head-center .eyebrow { color: var(--brass-300); }
  .section-head-center h2 {
    font-family: var(--font-serif-cn);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--fg-primary);
    margin: 0;
  }
  .section-head-center h2.serif-italic {
    font-family: var(--font-serif);
    font-style: italic;
    letter-spacing: 0;
  }
  .section-head-center .subtitle {
    font-family: var(--font-serif-cn);
    font-size: var(--text-sm);
    color: var(--fg-secondary);
    margin-top: var(--space-3);
  }

  /* === 11 大類 === */
  .menu-row {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6) var(--space-4);
  }
  @media (min-width: 600px) { .menu-row { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 960px) { .menu-row { grid-template-columns: repeat(6, 1fr); } }

  .menu-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: inherit;
    text-decoration: none;
    transition: opacity var(--duration-base) var(--ease-out);
  }
  .menu-tile:hover { opacity: 0.85; }
  .menu-cover {
    aspect-ratio: 1;
    width: 100%;
    background: var(--bg-soft);
    display: grid;
    place-items: center;
    overflow: hidden;
    margin-bottom: var(--space-3);
  }
  .menu-cover img {
    width: 80%; height: 80%; object-fit: contain;
    transition: transform var(--duration-slow) var(--ease-out),
                filter var(--duration-slow) var(--ease-out);
  }
  [data-theme='dark'] .menu-cover img {
    filter: brightness(0.92) saturate(0.9);
  }
  [data-theme='dark'] .menu-cover {
    background: radial-gradient(circle at center, var(--ink-700) 0%, var(--ink-800) 100%);
  }
  .menu-tile:hover .menu-cover img { transform: scale(1.05); filter: none; }
  .menu-cover-fallback {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, var(--cream-100), var(--cream-200));
  }
  [data-theme='dark'] .menu-cover-fallback {
    background: linear-gradient(135deg, var(--ink-800), var(--ink-700));
  }
  .menu-label-en {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: var(--text-lg);
    color: var(--fg-primary);
  }
  .menu-label-cn {
    font-family: var(--font-serif-cn);
    font-size: var(--text-xs);
    color: var(--fg-secondary);
    margin-top: 4px;
    letter-spacing: 0.2em;
  }

  .menu-row-extra {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-7);
  }
  @media (min-width: 600px) { .menu-row-extra { grid-template-columns: repeat(5, 1fr); } }
  .menu-tile.small .menu-label-en { font-size: var(--text-base); }
  .menu-tile.small .menu-label-cn { font-size: 11px; }

  /* === Featured products === */
  .product-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4) var(--space-5);
  }
  @media (min-width: 600px) { .product-row { grid-template-columns: repeat(3, 1fr); gap: var(--space-6); } }
  @media (min-width: 900px) { .product-row { grid-template-columns: repeat(5, 1fr); } }
  .section-cta { display: flex; justify-content: center; margin-top: var(--space-7); }

  /* === Editorial banner === */
  .editorial-banner {
    position: relative;
    overflow: hidden;
    color: var(--cream-050);
    background: var(--ink-900);
    padding: 0;
  }
  .editorial-bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.5;
    filter: contrast(0.9);
  }
  .editorial-shade {
    position: absolute; inset: 0;
    background: linear-gradient(90deg,
      rgba(26,24,22,0.85) 0%,
      rgba(26,24,22,0.55) 50%,
      rgba(26,24,22,0.25) 100%);
  }
  .editorial-content {
    position: relative; z-index: 2;
    padding-block: var(--space-9);
    max-width: 640px;
  }
  .editorial-eyebrow {
    color: var(--brass-300);
  }
  .editorial-title {
    font-family: var(--font-serif-cn);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: 0.08em;
    margin: var(--space-3) 0;
    color: var(--cream-050);
  }
  .editorial-sub {
    font-family: var(--font-serif-cn);
    color: rgba(245,241,232,0.75);
    font-size: var(--text-base);
    line-height: 1.85;
    margin-bottom: var(--space-6);
  }

  /* === Brand wall === */
  .brand-wall {
    padding-block: var(--space-8);
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
    background: var(--bg-base);
  }
  .brand-row {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4) var(--space-7);
    align-items: center;
    justify-items: center;
  }
  @media (min-width: 600px) { .brand-row { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 900px) { .brand-row { grid-template-columns: repeat(8, 1fr); } }
  .brand-row li span {
    color: var(--fg-secondary);
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: 0.08em;
    font-size: var(--text-sm);
    transition: color var(--duration-base) var(--ease-out);
  }
  .brand-row li:hover span { color: var(--fg-primary); }
</style>
