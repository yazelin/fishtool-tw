---
interface Props {
  pid: number;
  sku?: string | null;
  name: string | null;
  price?: number | null;
  salePrice?: number | null;
  thumb?: string | null;
  brand?: string | null;
}

import { url } from '../lib/data';
const { pid, sku, name, price, salePrice, thumb, brand } = Astro.props;
const href = url(`products/${pid}`);
const hasSale = price !== null && price !== undefined && salePrice !== null && salePrice !== undefined && salePrice < price;
const formatPrice = (n?: number | null) =>
  n == null ? '—' : `NT$${n.toLocaleString('zh-Hant')}`;
---

<a class="card" href={href}>
  <div class="thumb">
    {thumb ? (
      <img src={thumb} alt={name ?? ''} loading="lazy" decoding="async" />
    ) : (
      <div class="thumb-empty" aria-hidden="true">無圖</div>
    )}
  </div>
  <div class="body">
    {brand && <span class="brand">{brand}</span>}
    <h3 class="name">{name ?? '（無標題）'}</h3>
    <div class="price">
      {hasSale ? (
        <>
          <span class="sale">{formatPrice(salePrice)}</span>
          <span class="orig">{formatPrice(price)}</span>
          <span class="sale-tag">Sale</span>
        </>
      ) : (
        <span class="sale">{formatPrice(salePrice ?? price)}</span>
      )}
    </div>
  </div>
</a>

<style>
  /* Editorial / borderless：靠商品照與留白做主視覺，不靠框 */
  .card {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    transition: opacity var(--duration-base) var(--ease-out);
  }
  .card:hover { opacity: 0.85; }

  .thumb {
    aspect-ratio: 1;
    position: relative;
    background: var(--bg-soft);
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }
  .thumb img {
    width: 90%;
    height: 90%;
    object-fit: contain;
    transition: transform var(--duration-slow) var(--ease-out),
                filter var(--duration-slow) var(--ease-out);
  }
  /* dark 模式：原始白底商品照在暗頁上會「跳」，降亮 + 微減飽和讓它融入 */
  :global([data-theme='dark']) .thumb img {
    filter: brightness(0.92) saturate(0.9);
  }
  :global([data-theme='dark']) .thumb {
    background: radial-gradient(circle at center, var(--ink-700) 0%, var(--ink-800) 100%);
  }
  .card:hover .thumb img {
    filter: none;
    transform: scale(1.04);
  }
  .card:hover .thumb img { transform: scale(1.04); }
  .thumb-empty {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    font-family: var(--font-serif-cn);
    font-style: italic;
  }

  .body {
    padding: var(--space-4) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .brand {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--brass-700);
    letter-spacing: 0.02em;
  }
  [data-theme='dark'] .brand { color: var(--brass-300); }

  .name {
    font-family: var(--font-serif-cn);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.45;
    color: var(--fg-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.9em;
    letter-spacing: 0.01em;
  }

  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-family: var(--font-sans);
  }
  .price .sale {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--fg-primary);
    letter-spacing: 0;
  }
  .price .orig {
    font-size: var(--text-xs);
    color: var(--fg-muted);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  .price .sale-tag {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xs);
    color: var(--ember-600);
    margin-left: auto;
  }
</style>
