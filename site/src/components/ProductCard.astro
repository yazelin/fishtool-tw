---
interface Props {
  pid: number;
  sku?: string | null;
  name: string | null;
  price?: number | null;
  salePrice?: number | null;
  thumb?: string | null;
  brand?: string | null;
}

import { url } from '../lib/data';
const { pid, sku, name, price, salePrice, thumb, brand } = Astro.props;
const href = url(`products/${pid}`);
const hasSale = price !== null && price !== undefined && salePrice !== null && salePrice !== undefined && salePrice < price;
const formatPrice = (n?: number | null) =>
  n == null ? '—' : `$${n.toLocaleString('zh-Hant')}`;
---

<a class="card" href={href}>
  <div class="thumb">
    {thumb ? (
      <img src={thumb} alt={name ?? ''} loading="lazy" decoding="async" />
    ) : (
      <div class="thumb-empty" aria-hidden="true">無圖</div>
    )}
    {hasSale && <span class="badge badge-sale ribbon">特價</span>}
  </div>
  <div class="body">
    <div class="meta">
      {brand && <span class="brand">{brand}</span>}
      {sku && <span class="sku">{sku}</span>}
    </div>
    <h3 class="name">{name ?? '（無標題）'}</h3>
    <div class="price">
      {hasSale ? (
        <>
          <span class="sale">{formatPrice(salePrice)}</span>
          <span class="orig"><span class="orig-label">原</span> {formatPrice(price)}</span>
        </>
      ) : (
        <span class="sale">{formatPrice(salePrice ?? price)}</span>
      )}
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out);
    color: inherit;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .thumb {
    aspect-ratio: 1;
    position: relative;
    background: var(--ink-800);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .card:hover .thumb img { transform: scale(1.03); }
  .thumb-empty {
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }
  .ribbon {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
  }

  .body {
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--fg-secondary);
  }
  .brand {
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .sku { color: var(--fg-muted); }

  .name {
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.3;
    color: var(--fg-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.6em;
  }

  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }
  .price .sale {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--accent-ember);
    letter-spacing: -0.01em;
  }
  .price .orig {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  .price .orig-label {
    text-decoration: none;
    display: inline-block;
    margin-right: 2px;
    font-size: 11px;
  }

  /* 在較小欄位（手機 2 欄）字級略縮 */
  @media (max-width: 600px) {
    .name { font-size: var(--text-base); }
    .price .sale { font-size: var(--text-lg); }
  }
</style>
