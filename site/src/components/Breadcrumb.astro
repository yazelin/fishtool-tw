---
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav class="breadcrumb" aria-label="麵包屑">
  <ol>
    <li><a href={base}>首頁</a></li>
    {items.map((c, i) => (
      <li>
        <span aria-hidden="true" class="sep">/</span>
        {c.href && i < items.length - 1 ? (
          <a href={c.href}>{c.label}</a>
        ) : (
          <span class="current">{c.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--fg-secondary);
  }
  .breadcrumb a { color: var(--fg-secondary); }
  .breadcrumb a:hover { color: var(--fg-primary); }
  .current { color: var(--fg-primary); }
  .sep { margin-right: var(--space-2); color: var(--fg-muted); }
</style>
