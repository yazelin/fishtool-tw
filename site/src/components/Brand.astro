---
// 紅海釣具 v0.4 品牌識別：用原 logo 像素級重染後的 PNG（保留原本筆觸體形）
// light 版：brass + 暖墨黑
// dark 版：brass + cream
// 用法：
//   <Brand />              — 預設 md
//   <Brand size="lg" />
//   <Brand href="/" />     — wrap 成連結
import { url } from '../lib/data';

interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  href?: string | false;
  tone?: 'auto' | 'light' | 'dark';   // auto = 跟 [data-theme] 切；light/dark = 強制
}

const { size = 'md', href = false, tone = 'auto' } = Astro.props;

const heightPx = {
  sm: 28,
  md: 36,
  lg: 48,
  xl: 64,
}[size];

const Wrapper = href ? 'a' : 'span';
---

<Wrapper class:list={["brand", `size-${size}`, `tone-${tone}`]} {...(href ? { href, 'aria-label': '紅海釣具 FishTool.tw 首頁' } : {})}>
  <img
    src={url('logo-brass.png')}
    alt="紅海釣具 FishTool.tw"
    width={heightPx * 5.435}
    height={heightPx}
    class="logo logo-light"
  />
  <img
    src={url('logo-brass-dark.png')}
    alt=""
    aria-hidden="true"
    width={heightPx * 5.435}
    height={heightPx}
    class="logo logo-dark"
  />
</Wrapper>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
    line-height: 0;
  }
  .logo {
    display: block;
    height: auto;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  /* auto：跟 [data-theme] 切（預設） */
  .tone-auto .logo-light { display: block; }
  .tone-auto .logo-dark  { display: none; }
  :global([data-theme='dark']) .tone-auto .logo-light { display: none; }
  :global([data-theme='dark']) .tone-auto .logo-dark  { display: block; }

  /* light：強制使用 light 版（淺底） */
  .tone-light .logo-light { display: block; }
  .tone-light .logo-dark  { display: none; }

  /* dark：強制使用 dark 版（暗底，例如 footer 永遠暗） */
  .tone-dark .logo-light { display: none; }
  .tone-dark .logo-dark  { display: block; }

  /* hover 時整體微透明 */
  a.brand:hover .logo { opacity: 0.85; }
</style>
