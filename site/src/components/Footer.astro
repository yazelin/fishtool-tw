        </a>
        <a href="mailto:service@fishtool.tw" aria-label="寄信給客服" title="service@fishtool.tw">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        </a>
      </div>
    </section>

    <section>
      <h3>客服資訊</h3>
      <ul>
        <li>Email：<a href="mailto:service@fishtool.tw">service@fishtool.tw</a></li>
        <li>LINE：<a href="https://line.me/ti/p/~fishtool2012" target="_blank" rel="noopener">fishtool2012</a></li>
        <li>網路客服：每日 10:00 – 18:00</li>
        <li>
          <a href="http://fishtool.tw/web/byelove/asp1/chat_front.asp" target="_blank" rel="noopener">線上聊聊</a>
          <span class="aside-meta">（原站，外開）</span>
        </li>
        <li><a href={url('order')}>訂單查詢</a></li>
        <li><a href={url('faq')}>購物需知</a></li>
        <li><a href={url('inquiry')}>客服詢問</a></li>
      </ul>
    </section>

    <section>
      <h3>商店資訊</h3>
      <ul>
        <li>
          <a href="https://www.google.com/maps?cid=6905504329298202989" target="_blank" rel="noopener">
            中壢市民族路二段 110 號
          </a>
        </li>
        <li>電話：<a href="tel:034951686">03-4951686</a></li>
        <li>門市營業：週一至週六 10:00–22:00</li>
        <li>　　　　　週日 10:00–18:00</li>
      </ul>
    </section>

    <section>
      <h3>社群</h3>
      <ul>
        <li>
          <a href="https://www.facebook.com/groups/809912915726639/" target="_blank" rel="noopener">
            FB 中壢紅海釣具粉絲團
          </a>
        </li>
        <li>
          <a href="https://line.me/ti/p/~fishtool2012" target="_blank" rel="noopener">
            LINE@ fishtool2012
          </a>
        </li>
      </ul>
    </section>
  </div>

  <div class="footer-bottom container">
    <small>© {new Date().getFullYear()} 紅海釣具 · FishTool.tw</small>
    <small class="legal">
      <a href={url('privacy')}>隱私權</a>
      <span aria-hidden="true">·</span>
      <a href={url('terms')}>服務條款</a>
    </small>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    background: var(--ink-900);
    color: var(--ink-300);
    border-top: 1px solid var(--ink-700);
    padding: var(--space-8) 0 var(--space-5);
  }
  [data-theme='light'] .site-footer {
    background: var(--ink-900);
    color: var(--ink-300);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 600px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .footer-grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: var(--space-7); }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    line-height: 1;
    color: var(--ink-100);
    margin-bottom: var(--space-3);
  }
  .footer-brand .brand-cn { font-size: var(--text-xl); font-weight: 700; }
  .footer-brand .brand-en {
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ink-500);
    margin-top: 4px;
    font-style: italic;
  }
  .brand-desc { font-size: var(--text-sm); line-height: 1.7; }

  .social-row {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .social-row a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    color: var(--ink-300);
    transition: background var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }
  .social-row a:hover {
    background: rgba(255,255,255,0.14);
    color: var(--ink-100);
  }

  .site-footer h3 {
    font-size: var(--text-base);
    color: var(--ink-100);
    margin-bottom: var(--space-3);
    font-weight: 600;
  }
  .site-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .site-footer a { color: var(--ink-300); }
  .site-footer a:hover { color: var(--ink-100); }
  .aside-meta { font-size: 11px; color: var(--ink-500); margin-left: 4px; }

  .footer-bottom {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink-700);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--ink-500);
  }
  .footer-bottom a { color: var(--ink-300); }
  .footer-bottom a:hover { color: var(--ink-100); }
  .legal { display: inline-flex; gap: var(--space-2); align-items: center; }
</style>
