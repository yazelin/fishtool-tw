---
import { url } from '../lib/data';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <section class="brand-block">
      <div class="footer-brand">
        <span class="brand-cn">紅海釣具</span>
        <span class="brand-en">RED&nbsp;SEA&nbsp;TACKLE</span>
      </div>
      <p class="brand-desc">磯釣、灘釣、船釣、釣蝦、路亞——多元釣具一站精選。<br />實體門市與線上同步出貨。</p>
    </section>

    <section>
      <h3>客服資訊</h3>
      <ul>
        <li><a href="mailto:service@fishtool.tw">service@fishtool.tw</a></li>
        <li>線上聊聊：10:00 – 21:00</li>
        <li><a href={url('order')}>訂單查詢</a></li>
        <li><a href={url('faq')}>常見問題</a></li>
        <li><a href={url('inquiry')}>客服詢問</a></li>
      </ul>
    </section>

    <section>
      <h3>商店資訊</h3>
      <ul>
        <li>地址：實體門市（待補）</li>
        <li>電話：（待補）</li>
        <li>營業時間：週一至週日 10:00 – 21:00</li>
        <li>運送方式：宅配 / 店面自取</li>
      </ul>
    </section>

    <section>
      <h3>社群</h3>
      <ul>
        <li>
          <a
            href="https://www.facebook.com/groups/809912915726639/"
            target="_blank"
            rel="noopener"
          >Facebook 社團</a>
        </li>
      </ul>
    </section>
  </div>

  <div class="footer-bottom container">
    <small>© {new Date().getFullYear()} 紅海釣具 RED SEA TACKLE</small>
    <small class="legal">
      <a href={url('privacy')}>隱私權</a>
      <span aria-hidden="true">·</span>
      <a href={url('terms')}>服務條款</a>
    </small>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    background: var(--ink-900);
    color: var(--ink-300);
    border-top: 1px solid var(--ink-700);
    padding: var(--space-8) 0 var(--space-5);
  }
  [data-theme='light'] .site-footer {
    background: var(--ink-900);
    color: var(--ink-300);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 600px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .footer-grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: var(--space-7); }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    line-height: 1;
    color: var(--ink-100);
    margin-bottom: var(--space-3);
  }
  .footer-brand .brand-cn { font-size: var(--text-xl); font-weight: 700; }
  .footer-brand .brand-en {
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--ink-500);
    margin-top: 4px;
  }
  .brand-desc { font-size: var(--text-sm); line-height: 1.7; }

  .site-footer h3 {
    font-size: var(--text-base);
    color: var(--ink-100);
    margin-bottom: var(--space-3);
    font-weight: 600;
  }
  .site-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .site-footer a { color: var(--ink-300); }
  .site-footer a:hover { color: var(--ink-100); }

  .footer-bottom {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink-700);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--ink-500);
  }
  .footer-bottom a { color: var(--ink-300); }
  .footer-bottom a:hover { color: var(--ink-100); }
  .legal { display: inline-flex; gap: var(--space-2); align-items: center; }
</style>
