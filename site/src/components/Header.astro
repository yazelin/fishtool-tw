---
import { getCollection } from 'astro:content';
import { url } from '../lib/data';

let menus: any[] = [];
try {
  menus = (await getCollection('menus')).sort((a, b) => a.data.menu_id - b.data.menu_id);
} catch {
  // seed 階段沒資料時不阻塞
  menus = [];
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href={url()} class="brand">
      <span class="brand-cn">紅海釣具</span>
      <span class="brand-en">RED&nbsp;SEA&nbsp;TACKLE</span>
    </a>

    <form class="search" role="search" action={url('search')} method="get">
      <input
        type="search"
        name="q"
        placeholder="搜尋釣竿、捲線器、品牌、編號"
        aria-label="搜尋商品"
      />
      <button type="submit" aria-label="送出搜尋">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </button>
    </form>

    <nav class="quick-nav" aria-label="快速功能">
      <a href={url('order')}>訂單查詢</a>
      <a href={url('inquiry')}>客服</a>
      <button class="theme-toggle" aria-label="切換亮暗" id="theme-toggle">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"></path>
        </svg>
      </button>
    </nav>
  </div>

  {menus.length > 0 && (
    <nav class="main-nav container" aria-label="主分類">
      <ul>
        {menus.map((m) => (
          <li>
            <a href={url(`menus/${m.data.menu_id}`)}>{m.data.name}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.dataset.theme === 'light' ? 'dark' : 'light';
    html.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
  try {
    const saved = localStorage.getItem('theme');
    if (saved) document.documentElement.dataset.theme = saved;
  } catch {}
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--bg-base) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
    z-index: 50;
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: 64px;
  }
  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1;
    color: var(--fg-primary);
    font-weight: 700;
    text-decoration: none;
  }
  .brand-cn { font-size: var(--text-lg); }
  .brand-en {
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--fg-muted);
    margin-top: 2px;
  }

  .search {
    flex: 1;
    max-width: 480px;
    position: relative;
    display: flex;
    align-items: center;
  }
  .search input {
    width: 100%;
    height: 40px;
    padding: 0 var(--space-9) 0 var(--space-4);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    color: var(--fg-primary);
  }
  .search input::placeholder { color: var(--fg-muted); }
  .search button {
    position: absolute;
    right: 4px;
    height: 32px;
    width: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--fg-secondary);
  }
  .search button:hover { color: var(--brand-tide); }

  .quick-nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--text-sm);
  }
  .quick-nav a { color: var(--fg-secondary); }
  .quick-nav a:hover { color: var(--fg-primary); }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--fg-secondary);
  }
  .theme-toggle:hover {
    background: var(--bg-elevated-hover);
    color: var(--fg-primary);
  }

  .main-nav ul {
    display: flex;
    list-style: none;
    padding: 0 var(--space-4);
    margin: 0;
    gap: var(--space-5);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .main-nav ul::-webkit-scrollbar { display: none; }
  .main-nav li a {
    display: inline-block;
    padding: var(--space-3) 0;
    color: var(--fg-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  .main-nav li a:hover {
    color: var(--fg-primary);
    border-bottom-color: var(--brand-tide);
  }

  @media (max-width: 767px) {
    .header-inner { flex-wrap: wrap; gap: var(--space-3); height: auto; padding-block: var(--space-3); }
    .search { order: 3; flex-basis: 100%; max-width: none; }
    .quick-nav a:not(.theme-toggle) { display: none; }
  }
</style>
