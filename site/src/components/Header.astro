---
import { getCollection } from 'astro:content';
import { url } from '../lib/data';

let menus: any[] = [];
try {
  menus = (await getCollection('menus')).sort((a, b) => a.data.menu_id - b.data.menu_id);
} catch {
  menus = [];
}
---

<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <button class="hamburger" id="navToggle" aria-label="開啟主選單" aria-expanded="false" aria-controls="mobileNav">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <a href={url()} class="brand" aria-label="紅海釣具 首頁">
      <span class="brand-cn">紅海釣具</span>
      <span class="brand-en">RED&nbsp;SEA&nbsp;TACKLE</span>
    </a>

    <form class="search" role="search" action={url('search')} method="get">
      <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        type="search"
        name="q"
        placeholder="搜尋釣竿、捲線器、品牌、編號"
        aria-label="搜尋商品"
      />
    </form>

    <nav class="quick-nav" aria-label="快速功能">
      <a href={url('order')} class="quick-link">訂單查詢</a>
      <a href={url('inquiry')} class="quick-link">客服</a>
      <button class="icon-btn theme-toggle" aria-label="切換亮暗" id="theme-toggle">
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
        </svg>
      </button>
      <a href={url('cart')} class="icon-btn cart" aria-label="購物車（0 件）">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path>
        </svg>
        <span class="cart-badge" aria-hidden="true">0</span>
      </a>
    </nav>
  </div>

  {menus.length > 0 && (
    <nav class="main-nav" aria-label="主分類">
      <div class="container">
        <ul>
          {menus.map((m) => (
            <li>
              <a href={url(`menus/${m.data.menu_id}`)}>{m.data.name}</a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )}

  {menus.length > 0 && (
    <div class="mobile-nav" id="mobileNav" hidden>
      <nav aria-label="行動版主分類">
        <ul>
          {menus.map((m) => (
            <li>
              <a href={url(`menus/${m.data.menu_id}`)}>{m.data.name}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="mobile-quick">
        <a href={url('order')}>訂單查詢</a>
        <a href={url('inquiry')}>客服詢問</a>
        <a href={url('faq')}>常見問題</a>
      </div>
    </div>
  )}
</header>

<script is:inline>
  // 主題切換
  const themeBtn = document.getElementById('theme-toggle');
  themeBtn?.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.dataset.theme === 'light' ? 'dark' : 'light';
    html.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });

  // 滾動時加 scrolled class（>80px 才上 backdrop 與細邊）
  const header = document.getElementById('siteHeader');
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 80) header.classList.add('is-scrolled');
    else header.classList.remove('is-scrolled');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 行動版漢堡選單
  const toggle = document.getElementById('navToggle');
  const drawer = document.getElementById('mobileNav');
  toggle?.addEventListener('click', () => {
    if (!drawer) return;
    const open = drawer.hasAttribute('hidden') ? true : false;
    if (open) drawer.removeAttribute('hidden'); else drawer.setAttribute('hidden', '');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? '關閉主選單' : '開啟主選單');
  });

  // 鍵盤快捷：按 / 聚焦搜尋
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
      e.preventDefault();
      document.querySelector('.site-header .search input')?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    background: var(--bg-base);
    z-index: 50;
    transition: background var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--bg-base) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--border-subtle);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: 64px;
  }

  .hamburger {
    display: none;
    width: 40px;
    height: 40px;
    margin-left: calc(var(--space-2) * -1);
    border-radius: var(--radius-sm);
    color: var(--fg-primary);
    place-items: center;
  }
  .hamburger:hover { background: var(--bg-elevated-hover); }

  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1;
    color: var(--fg-primary);
    font-weight: 700;
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand-cn {
    font-size: var(--text-lg);
    letter-spacing: 0.02em;
  }
  .brand-en {
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--fg-muted);
    margin-top: 3px;
  }

  .search {
    flex: 1;
    max-width: 480px;
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-icon {
    position: absolute;
    left: var(--space-4);
    color: var(--fg-muted);
    pointer-events: none;
  }
  .search input {
    width: 100%;
    height: 40px;
    padding: 0 var(--space-4) 0 calc(var(--space-4) + 22px);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    color: var(--fg-primary);
    font-size: var(--text-sm);
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .search input::placeholder { color: var(--fg-muted); }
  .search input:focus {
    border-color: var(--brand-tide);
    outline: 2px solid var(--brand-tide);
    outline-offset: 0;
  }

  .quick-nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    margin-left: auto;
  }
  .quick-link {
    color: var(--fg-secondary);
    padding: var(--space-2) var(--space-2);
  }
  .quick-link:hover { color: var(--fg-primary); }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--fg-secondary);
    position: relative;
  }
  .icon-btn:hover {
    background: var(--bg-elevated-hover);
    color: var(--fg-primary);
  }
  .cart-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--accent-ember);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    display: grid;
    place-items: center;
    line-height: 1;
  }

  .main-nav { border-top: 1px solid var(--border-subtle); }
  .main-nav ul {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: var(--space-6);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .main-nav ul::-webkit-scrollbar { display: none; }
  .main-nav li a {
    display: inline-block;
    padding: var(--space-3) 0;
    color: var(--fg-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }
  .main-nav li a:hover {
    color: var(--fg-primary);
    border-bottom-color: var(--brand-tide);
  }

  /* === 行動版 === */
  .mobile-nav {
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-base);
    padding-block: var(--space-3);
  }
  .mobile-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-1);
  }
  .mobile-nav li a {
    display: block;
    padding: var(--space-3) var(--space-4);
    color: var(--fg-primary);
    font-weight: 500;
    border-radius: var(--radius-sm);
  }
  .mobile-nav li a:hover { background: var(--bg-elevated); }
  .mobile-quick {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4) 0;
    margin-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-sm);
  }
  .mobile-quick a { color: var(--fg-secondary); }

  @media (max-width: 767px) {
    .hamburger { display: grid; }
    .main-nav { display: none; }
    .header-inner { gap: var(--space-3); height: 56px; }
    .quick-link { display: none; }
    .brand-en { display: none; }
    .brand-cn { font-size: var(--text-base); }
    .search { order: 3; flex-basis: 100%; max-width: none; margin-bottom: var(--space-3); }
    .site-header { padding-bottom: 0; }
  }
  @media (min-width: 768px) {
    .mobile-nav { display: none !important; }
  }
</style>
