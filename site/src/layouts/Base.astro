---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = '紅海釣具 FishTool.tw — 磯釣 / 灘釣 / 船釣 / 釣蝦 / 路亞，中壢實體門市與線上同步出貨。SHIMANO、DAIWA、OWNER、gamakatsu 等 30+ 品牌長期供貨。',
  ogImage,
} = Astro.props;

const siteName = '紅海釣具';
const fullTitle = title === siteName ? title : `${title} ｜ ${siteName}`;
const siteUrl = Astro.site?.toString().replace(/\/+$/, '') ?? '';
const defaultOg = `${siteUrl}${url('og-image.png')}`;
const ogImageFull = ogImage ?? defaultOg;
---

<!doctype html>
<html lang="zh-Hant" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    {/* Open Graph */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="紅海釣具 FishTool.tw" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={ogImageFull} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="紅海釣具 FishTool.tw — 探索無限可能 釣出你的精彩" />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageFull} />

    {/* Favicons — 銅印 PNG 為主、SVG 為 fallback */}
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('favicon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,400;1,500;1,600&family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;600&family=Noto+Serif+TC:wght@400;500;600;700&display=swap" />
    <title>{fullTitle}</title>
    <script is:inline>
      // 預設 dark；如使用者選過，沿用偏好（避免 FOUC）
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">跳到主要內容</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      .skip-link {
        position: absolute;
        top: -40px;
        left: 8px;
        background: var(--brass-500);
        color: #fff;
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-sm);
        z-index: 1000;
      }
      .skip-link:focus {
        top: 8px;
      }
    </style>
  </body>
</html>
